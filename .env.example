# Copy to .env (never commit .env). All settings are optional; config.json holds the defaults.
# No API keys or credentials are needed by this project.

# Use a different config file
# RENTSCRAPER_CONFIG=config.json

# Only run some sources (comma separated): myhome,spotahome,housinganywhere,daft,propertyie,rentie,letie,roomsforrent
# RENTSCRAPER_SOURCES=myhome,spotahome,housinganywhere

# Where results and history go
# RENTSCRAPER_OUTPUT_DIR=output
# RENTSCRAPER_HISTORY_FILE=data/history.json

# Politeness: seconds between requests to the same website (do not set below 2)
# RENTSCRAPER_MIN_DELAY=3

# Cap search pages per search (useful for a quick test run)
# RENTSCRAPER_MAX_PAGES=2

# DEBUG, INFO, WARNING
# RENTSCRAPER_LOG_LEVEL=INFO
